{
  "kin": 1,
  "name": "Clotheskin",
  "purpose": "Shows what a Kin says it is wearing, as one natural sentence read from its recent chat.",
  "run": {
    "entry": "node main.js",
    "timeout": "2m"
  },
  "screens": [
    {
      "slot": "panel",
      "entry": "screen/index.html",
      "title": "Clotheskin"
    }
  ],
  "actions": [
    {
      "name": "read_outfit",
      "description": "Reads the Kin’s recent chat and describes what it is wearing in one sentence.",
      "input": {
        "type": "object",
        "properties": {
          "kin": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "kin"
        ]
      },
      "by": [
        "user"
      ]
    }
  ],
  "grants": [
    "kin:read",
    "chat:read:1"
  ]
}
