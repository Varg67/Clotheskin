{
  "kin": 1,
  "name": "Clotheskin",
  "purpose": "Shows where a Kin is, what it is doing and what it is wearing, read from its recent chat, now or on a schedule.",
  "triggers": [
    {
      "on": "schedule",
      "cron": "*/5 * * * *",
      "tz": "user"
    }
  ],
  "run": {
    "entry": "node main.js",
    "timeout": "4m"
  },
  "screens": [
    {
      "slot": "panel",
      "entry": "screen/index.html",
      "title": "Clotheskin"
    }
  ],
  "actions": [
    {
      "name": "read_outfit",
      "description": "Reads the Kin’s recent chat and describes what it is wearing in one sentence.",
      "input": {
        "type": "object",
        "properties": {
          "kin": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "kin"
        ]
      },
      "by": [
        "user"
      ]
    }
  ],
  "grants": [
    "kin:read",
    "chat:read:1"
  ]
}
