{
  "kin": 1,
  "name": "Clotheskin",
  "purpose": "Shows where your Kin is, what it is doing and what it is wearing, read from its recent chat, and follows its nights: when it sleeps and what it dreamt.",
  "triggers": [
    {
      "on": "schedule",
      "cron": "*/15 * * * *",
      "tz": "user"
    }
  ],
  "run": {
    "entry": "node main.js",
    "timeout": "2m"
  },
  "screens": [
    {
      "slot": "panel",
      "entry": "screen/index.html",
      "title": "Clotheskin"
    }
  ],
  "actions": [
    {
      "name": "update_status",
      "description": "Reads the selected Kin now (where it is, its pose and action, its outfit), or asks about its dream when it is asleep.",
      "input": {
        "type": "object",
        "properties": {
          "kin": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "op": {
            "type": "string",
            "enum": [
              "read",
              "wake"
            ]
          }
        },
        "required": [
          "kin"
        ]
      },
      "by": [
        "user"
      ]
    }
  ],
  "grants": [
    "kin:read",
    "chat:read:2"
  ]
}
