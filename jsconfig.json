{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022", "dom", "dom.iterable"],
    "typeRoots": ["./tools/node_modules/@types"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": ["main.js", "server.mjs", "run/**/*.js", "src/**/*.js", "scripts/**/*.mjs"],
  "exclude": ["screen/app.js", "tools", "node_modules"]
}
