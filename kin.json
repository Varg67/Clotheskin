{
  "kin": 1,
  "name": "Clotheskin",
  "purpose": "Shows where a Kin is, what it is doing and what it is wearing, as three short sentences read from its recent chat.",
  "run": {
    "entry": "node main.js",
    "timeout": "2m"
  },
  "screens": [
    {
      "slot": "panel",
      "entry": "screen/index.html",
      "title": "Clotheskin"
    }
  ],
  "actions": [
    {
      "name": "read_outfit",
      "description": "Reads the Kin’s recent chat and describes where it is, its pose and action, and what it is wearing.",
      "input": {
        "type": "object",
        "properties": {
          "kin": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "kin"
        ]
      },
      "by": [
        "user"
      ]
    },
    {
      "name": "ask_sleep",
      "description": "Asks a Kin that seems asleep whether it is, and at what time it plans to wake up.",
      "input": {
        "type": "object",
        "properties": {
          "kin": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "now": {
            "type": "string"
          }
        },
        "required": [
          "kin"
        ]
      },
      "by": [
        "user"
      ]
    },
    {
      "name": "ask_dream",
      "description": "Asks a Kin that is waking up what it dreamt and how much of the dream it remembers.",
      "input": {
        "type": "object",
        "properties": {
          "kin": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "now": {
            "type": "string"
          }
        },
        "required": [
          "kin"
        ]
      },
      "by": [
        "user"
      ]
    }
  ],
  "grants": [
    "kin:read",
    "chat:read:1"
  ]
}
